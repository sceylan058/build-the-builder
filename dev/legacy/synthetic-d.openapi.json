{
 "openapi": "3.0.3",
 "info": {
  "title": "Freya Insurance tools (synthetic)",
  "version": "0.1"
 },
 "servers": [
  {
   "url": "https://freya-ins-mock.invalid/v1"
  }
 ],
 "paths": {
  "/get_claim": {
   "post": {
    "summary": "Find the claim and check the caller.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "policy_number": {
          "type": "string"
         },
         "date_of_birth": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "policy_number",
         "date_of_birth"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "verified": {
           "type": "boolean"
          },
          "wrong_answers_left": {
           "type": "integer"
          },
          "claim_id": {
           "type": "string"
          },
          "documents": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "doc_id": {
              "type": "string"
             },
             "kind": {
              "type": "string",
              "enum": [
               "police_report",
               "photos",
               "repair_estimate",
               "medical_report"
              ]
             },
             "status": {
              "type": "string"
             }
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/request_documents": {
   "post": {
    "summary": "Ask the policyholder for one missing document, with a due date.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "doc_id": {
          "type": "string"
         },
         "due_date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "doc_id",
         "due_date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/schedule_adjuster": {
   "post": {
    "summary": "Book an adjuster visit.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "date": {
          "type": "string",
          "format": "date"
         },
         "slot": {
          "type": "string",
          "enum": [
           "morning",
           "afternoon"
          ]
         }
        },
        "required": [
         "customer_id",
         "date",
         "slot"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/add_note": {
   "post": {
    "summary": "Record why a document will not be sent.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "doc_id": {
          "type": "string"
         },
         "reason": {
          "type": "string",
          "enum": [
           "not_available",
           "refused",
           "already_sent"
          ]
         }
        },
        "required": [
         "customer_id",
         "doc_id",
         "reason"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/schedule_callback": {
   "post": {
    "summary": "Book a callback for the policyholder.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "date": {
          "type": "string",
          "format": "date"
         },
         "time": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "date",
         "time"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last call.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "outcome": {
          "type": "string",
          "enum": [
           "docs_pending",
           "adjuster_scheduled",
           "denied_info",
           "callback"
          ]
         },
         "reason": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "outcome"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}