{
 "openapi": "3.0.3",
 "info": {
  "title": "Freya Air tools (synthetic)",
  "version": "0.1"
 },
 "servers": [
  {
   "url": "https://freya-air-mock.invalid/v1"
  }
 ],
 "paths": {
  "/lookup_booking": {
   "post": {
    "summary": "Find a booking and check the caller.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "pnr": {
          "type": "string"
         },
         "last_name": {
          "type": "string"
         },
         "flight_date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "pnr",
         "last_name",
         "flight_date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "found": {
           "type": "boolean"
          },
          "tickets": {
           "type": "array",
           "items": {
            "type": "object",
            "properties": {
             "ticket_id": {
              "type": "string"
             },
             "route": {
              "type": "string"
             },
             "departure": {
              "type": "string"
             },
             "fare": {
              "type": "number"
             },
             "hours_notice": {
              "type": "number"
             }
            }
           }
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/rebook_flight": {
   "post": {
    "summary": "Rebook one ticket.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "ticket_id": {
          "type": "string"
         },
         "new_date": {
          "type": "string",
          "format": "date"
         }
        },
        "required": [
         "customer_id",
         "ticket_id",
         "new_date"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          },
          "booking_id": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/issue_refund": {
   "post": {
    "summary": "Refund one ticket.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "ticket_id": {
          "type": "string"
         }
        },
        "required": [
         "customer_id",
         "ticket_id"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/issue_voucher": {
   "post": {
    "summary": "Issue a voucher for one ticket.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "ticket_id": {
          "type": "string"
         },
         "amount": {
          "type": "number"
         }
        },
        "required": [
         "customer_id",
         "ticket_id",
         "amount"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/escalate_to_agent": {
   "post": {
    "summary": "Hand over to a person.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "reason": {
          "type": "string",
          "enum": [
           "third_party",
           "request"
          ]
         }
        },
        "required": [
         "customer_id",
         "reason"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  },
  "/close_call": {
   "post": {
    "summary": "End the call. Always the last call.",
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "type": "object",
        "properties": {
         "customer_id": {
          "type": "string"
         },
         "outcome": {
          "type": "string",
          "enum": [
           "escalated",
           "refunded",
           "rebooked",
           "voucher_issued",
           "no_resolution"
          ]
         }
        },
        "required": [
         "customer_id",
         "outcome"
        ]
       }
      }
     }
    },
    "responses": {
     "200": {
      "description": "`ok` is false when the action was not carried out.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "properties": {
          "ok": {
           "type": "boolean"
          },
          "error": {
           "type": "string"
          }
         }
        }
       }
      }
     }
    }
   }
  }
 }
}